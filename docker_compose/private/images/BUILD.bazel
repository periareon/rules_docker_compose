load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "images",
    srcs = [
        "engine.go",
        "manifest.go",
        "oci.go",
        "ports.go",
        "reference.go",
    ],
    importpath = "github.com/periareon/rules_docker_compose/docker_compose/private/images",
    visibility = ["//docker_compose/private:__subpackages__"],
    deps = [
        "@com_github_opencontainers_go_digest//:go-digest",
        "@com_github_opencontainers_image_spec//specs-go",
        "@com_github_opencontainers_image_spec//specs-go/v1:specs-go",
    ],
)

go_test(
    name = "images_test",
    srcs = [
        "engine_test.go",
        "oci_test.go",
        "ports_test.go",
        "reference_test.go",
    ],
    embed = [":images"],
    deps = [
        "@com_github_opencontainers_go_digest//:go-digest",
        "@com_github_opencontainers_image_spec//specs-go/v1:specs-go",
    ],
)
