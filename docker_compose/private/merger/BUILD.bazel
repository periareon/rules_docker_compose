load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "merger_lib",
    srcs = ["merger.go"],
    importpath = "github.com/periareon/rules_docker_compose/docker_compose/private/merger",
    visibility = ["//visibility:private"],
    deps = [
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)

go_binary(
    name = "merger",
    embed = [":merger_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "merger_test",
    srcs = ["merger_test.go"],
    embed = [":merger_lib"],
)
