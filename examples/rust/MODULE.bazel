"""rules_docker_compose rust example"""

module(
    name = "rules_docker_compose_example",
    version = "0.0.0",
)

bazel_dep(name = "rules_docker_compose", version = "0.0.0")
bazel_dep(name = "rules_rust", version = "0.69.0")
bazel_dep(name = "rules_oci", version = "2.2.6")
bazel_dep(name = "platforms", version = "1.0.0")

local_path_override(
    module_name = "rules_docker_compose",
    path = "../../",
)

# Consume a release that includes https://github.com/bazel-contrib/rules_oci/pull/891
# This is not required for consumers.
archive_override(
    module_name = "rules_oci",
    integrity = "sha256-JD6sh+xB1o0dnm0hiEpQ7CjgMfcCsLn83H+Xw/PVOJo=",
    strip_prefix = "rules_oci-2.3.3",
    urls = ["https://github.com/bazel-contrib/rules_oci/releases/download/v2.3.3/rules_oci-v2.3.3.tar.gz"],
)

###############################################################################
## Rust external crates
###############################################################################

# https://bazelbuild.github.io/rules_rust/crate_universe_bzlmod.html
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crate_index",
    cargo_lockfile = "//:Cargo.lock",
    lockfile = "//:cargo-bazel-lock.json",
    manifests = ["//:Cargo.toml"],
)
use_repo(
    crate,
    "crate_index",
)

###############################################################################
## Images
###############################################################################

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "nginx",
    digest = "sha256:fb01117203ff38c2f9af91db1a7409459182a37c87cced5cb442d1d8fcc66d19",
    image = "nginx",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
    tag = "latest",
)
use_repo(
    oci,
    "nginx",
    "nginx_linux_amd64",
    "nginx_linux_arm64_v8",
)
