load("@rules_docker_compose//docker_compose:docker_compose_test.bzl", "docker_compose_test")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_venv//python:py_test.bzl", "py_test")

# An ordinary py_test. It needs the services running, so it is `manual` and
# only ever executed through `:simple_test` below.
py_test(
    name = "tester",
    srcs = ["tester.py"],
    env = {
        # Expanded by docker_compose_test once the daemon has assigned the port.
        "SERVICE_HOST": "$${RULES_DOCKER_COMPOSE_HOST_NGINX_80}",
    },
    tags = ["manual"],
    deps = [
        "@pip_deps//pytest",
        "@pip_deps//requests",
    ],
)

oci_image(
    name = "nginx",
    base = "@nginx",
    # rules_oci does not support windows: https://github.com/bazel-contrib/rules_oci/issues/53
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

oci_load(
    name = "nginx.load",
    image = ":nginx",
    repo_tags = [
        "rules_docker_compose_example_rust/nginx:latest",
    ],
)

docker_compose_test(
    name = "simple_test",
    images = [":nginx.load"],
    tags = ["requires-docker"],
    test = ":tester",
    yamls = ["docker-compose.yaml"],
)
